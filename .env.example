# 카카오톡 공유용 JavaScript 키 (https://developers.kakao.com → 내 애플리케이션 → 앱 키 → JavaScript 키)
# 설정하지 않으면 리포트탭의 "카카오톡으로 요약 공유" 버튼은 안내 메시지만 표시됩니다.
VITE_KAKAO_JS_KEY=

# ── 영양 앱(nutrition-cms) 연동 (2026-09-17 추가) ──────────────────────────
# 아래 두 값은 브라우저에 노출되면 안 되므로 VITE_ 접두사를 쓰지 않는다.
# Cloudflare Pages 대시보드 → 이 프로젝트 → Settings → Environment variables 에서
# "암호화된(Secret)" 변수로 등록할 것(.env 파일에 실제 값을 채워 커밋하지 말 것).

# functions/api/trainer-account.js, login-role.js가 이미 쓰는 것과 동일한 Firebase
# 서비스 계정 키(JSON 전체를 한 줄 문자열로). 아직 등록 안 돼 있다면 Firebase 콘솔
# → 프로젝트 설정 → 서비스 계정 → "새 비공개 키 생성"으로 발급.
FIREBASE_SERVICE_ACCOUNT_JSON=

# 영양 앱 연동 토큰(functions/_shared/nutritionToken.js) 서명용 비밀키.
# openssl rand -base64 32 등으로 무작위 생성 — 노출되면 즉시 재발급하고
# 기존 연결(nutritionConnections)을 전부 재연결하도록 안내해야 함.
NUTRITION_LINK_SECRET=
