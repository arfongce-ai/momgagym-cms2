rules_version = '2';

// 몸가짐 CMS — Firestore 보안 규칙
// 적용: Firebase 콘솔 → Firestore Database → 규칙(Rules) 탭에 붙여넣고 "게시".
// 또는 CLI:  firebase deploy --only firestore:rules
//
// 핵심 원칙
//  1) roles 컬렉션은 클라이언트에서 절대 write 금지(권한 탈취 차단). 읽기만 허용.
//  2) 운영 데이터는 "로그인한 사용자"만 접근(공개 차단).
//  3) 관리자 전용 데이터(매출/지출/정산/설정)는 roles 문서가 admin인 사용자만.
//
// ※ 더 강력한 방법은 Custom Claims(아래 가이드 참고). 그 경우 isAdmin()을
//   request.auth.token.admin == true 로 바꾸면 roles 문서 조회 비용도 사라진다.

service cloud.firestore {
  match /databases/{database}/documents {

    // 로그인 여부
    function isSignedIn() {
      return request.auth != null;
    }

    // roles/{uid} 문서로 관리자 판별 (Custom Claims 미사용 시)
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/roles/$(request.auth.uid))
        && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == 'admin';
    }

    // ── roles : 권한의 원천. 클라이언트 write 전면 금지 ──────────────
    // 읽기는 본인 역할 확인을 위해 로그인 사용자에게 허용.
    // 쓰기(생성/수정/삭제)는 어떤 클라이언트도 불가 →
    //   콘솔에서 수동으로 작성하거나 Admin SDK(서버)로만 변경.
    match /roles/{uid} {
      allow read:  if isSignedIn();
      allow write: if false;
    }

    // ── 일반 운영 데이터 : 로그인 사용자만 ───────────────────────────
    match /members/{id}    { allow read, write: if isSignedIn(); }
    match /trainers/{id}   { allow read, write: if isSignedIn(); }
    match /schedules/{id}  { allow read, write: if isSignedIn(); }
    match /notices/{id}    { allow read, write: if isSignedIn(); }
    match /payments/{id}   { allow read, write: if isSignedIn(); }
    match /body/{id}       { allow read, write: if isSignedIn(); }
    match /ai/{id}         { allow read, write: if isSignedIn(); }
    match /gait_reports/{id} { allow read, write: if isSignedIn(); }
    match /posture_reports/{id} { allow read, write: if isSignedIn(); }
    match /rom_reports/{id} { allow read, write: if isSignedIn(); }
    match /users/{userId}/reports/{reportId} { allow read, write: if isSignedIn(); }

    // ── 관리자 전용 데이터 ──────────────────────────────
    // 지출: 완전 관리자 전용
    match /expenses/{id}        { allow read, write: if isAdmin(); }
    // SNS·스터디 기록 / 정산 수동수정값:
    //   트레이너 본인 정산·기록 조회를 위해 '읽기'는 로그인 사용자 전체에 허용.
    //   '쓰기'(추가·수정·삭제)는 관리자만 — 트레이너 화면은 보기 전용.
    match /promos/{id}          { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /settleOverrides/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /settings/{id}        { allow read: if isSignedIn(); allow write: if isAdmin(); }
    // 데이터 무결성 검사(설정 > 데이터 무결성 검사) — 관리자 전용 도구이므로 완전 관리자 전용.
    match /integrityDismissals/{id} { allow read, write: if isAdmin(); }

    // ── 델타 동기화 인프라 ──────────────────────────────
    // meta/versions: 컬렉션별 마지막 쓰기 시각(문서 1개). 앱이 열릴 때 이 문서
    //   하나만 읽고 "바뀐 게 없으면 추가 읽기 0" 을 달성한다. 쓰기는 앱의 모든
    //   저장 동작이 수행하므로 로그인 사용자에게 허용(민감정보 없음 — 시각만).
    match /meta/{id} {
      allow read, write: if isSignedIn();
    }
    // deletions: 삭제 톰스톤(어느 컬렉션의 어떤 id가 언제 지워졌나).
    //   다른 기기의 캐시에서 삭제를 전파하기 위한 추가 전용(append-only) 로그.
    match /deletions/{id} {
      allow read, create: if isSignedIn();
      allow update, delete: if false;
    }

    // 그 외 모든 경로 기본 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
